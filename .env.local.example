# Placeholder values for the opt-in, loopback-only PostgreSQL Compose service.
# Replace every placeholder locally. Use URL-safe random passwords (for example, hex output).
POSTGRES_BOOTSTRAP_PASSWORD=REPLACE_WITH_LOCAL_RANDOM_HEX
SERVICEFLOW_MIGRATOR_PASSWORD=REPLACE_WITH_DIFFERENT_LOCAL_RANDOM_HEX
SERVICEFLOW_APP_PASSWORD=REPLACE_WITH_ANOTHER_LOCAL_RANDOM_HEX
POSTGRES_HOST_PORT=55432

# Replace URL password placeholders with the corresponding URL-safe password above.
DATABASE_URL=postgresql://serviceflow_app:REPLACE_APP_PASSWORD@127.0.0.1:55432/serviceflow_dev?schema=public
MIGRATION_DATABASE_URL=postgresql://serviceflow_migrator:REPLACE_MIGRATOR_PASSWORD@127.0.0.1:55432/serviceflow_dev?schema=public
SHADOW_DATABASE_URL=postgresql://serviceflow_migrator:REPLACE_MIGRATOR_PASSWORD@127.0.0.1:55432/serviceflow_shadow?schema=public
WEB_APP_URL=http://localhost:3000
CSRF_HMAC_SECRET=REPLACE_ME
RATE_LIMIT_HMAC_SECRET=REPLACE_ME
MFA_ENCRYPTION_KEYS={"local-v1":"REPLACE_WITH_BASE64_FOR_32_RANDOM_BYTES"}
MFA_ENCRYPTION_LEGACY_KEY_ID=local-v1
MFA_ENCRYPTION_ACTIVE_KEY_ID=local-v1
EMAIL_DELIVERY=local
NODE_ENV=development
PORT=3001
API_HOST=127.0.0.1
