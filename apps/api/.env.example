# Local PostgreSQL connections for ServiceFlow.
# Replace placeholders in your private .env file; never commit real credentials.

DATABASE_URL="postgresql://serviceflow_app:REPLACE_WITH_APP_PASSWORD@localhost:5432/serviceflow_dev"
MIGRATION_DATABASE_URL="postgresql://serviceflow_migrator:REPLACE_WITH_MIGRATOR_PASSWORD@localhost:5432/serviceflow_dev"
SHADOW_DATABASE_URL="postgresql://serviceflow_migrator:REPLACE_WITH_MIGRATOR_PASSWORD@localhost:5432/serviceflow_shadow"

# Development-only email delivery. Production must use a real provider.
NODE_ENV=development
EMAIL_DELIVERY=local
WEB_APP_URL=http://localhost:3000

# Dedicated 256-bit secret for HMAC-based rate-limit identifiers.
# Generate a unique secret for each environment.
RATE_LIMIT_HMAC_SECRET=REPLACE_WITH_64_HEX_CHARACTERS

# Dedicated 256-bit secret for session-bound CSRF tokens.
# Generate a unique secret for each environment.
CSRF_HMAC_SECRET=REPLACE_WITH_64_HEX_CHARACTERS
# MFA encryption keyring: each value must be canonical base64 for a 32-byte key.
# Keep the legacy key available until rotation and independent verification succeed.
# Replace placeholders with independently generated keys in each real environment.
MFA_ENCRYPTION_KEYS='{"v1":"REPLACE_WITH_BASE64_32_BYTE_LEGACY_KEY","v2":"REPLACE_WITH_BASE64_32_BYTE_ACTIVE_KEY"}'
MFA_ENCRYPTION_LEGACY_KEY_ID=v1
MFA_ENCRYPTION_ACTIVE_KEY_ID=v2

# Temporary backward compatibility for deployments not yet using the keyring.
# Do not configure this alongside MFA_ENCRYPTION_KEYS.
# MFA_ENCRYPTION_KEY=REPLACE_WITH_BASE64_ENCODED_32_BYTE_KEY
