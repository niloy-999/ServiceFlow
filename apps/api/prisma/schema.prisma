generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum BusinessStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
  CLOSED
}

enum BranchScopeType {
  BUSINESS
  BRANCH
}

enum ProductKind {
  RETAIL
  REPAIR_PART
  BOTH
}

enum CatalogueStatus {
  ACTIVE
  ARCHIVED
}

enum ProductIdentifierType {
  BARCODE
  ALTERNATE
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  emailNormalized String    @unique @map("email_normalized") @db.VarChar(320)
  passwordHash    String    @map("password_hash") @db.VarChar(255)
  displayName     String?   @map("display_name") @db.VarChar(160)
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)
  status          String    @default("ACTIVE") @db.VarChar(32)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  version         BigInt    @default(1)

  memberships             TenantMembership[]
  authSessions            AuthSession[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]

  platformAdminGrants           PlatformAdministrator[] @relation("PlatformAdminSubject")
  platformAdminGrantsIssued     PlatformAdministrator[] @relation("PlatformAdminGrantor")
  platformAdminGrantsRevoked    PlatformAdministrator[] @relation("PlatformAdminRevoker")
  mfa                           UserMfa?
  mfaEnrollment                 MfaEnrollment?
  mfaRecoveryCodes              MfaRecoveryCode[]
  mfaChallenges                 MfaChallenge[]
  auditEvents                   AuditEvent[]
  inventoryOperations           InventoryOperation[]
  inventoryAdjustmentsRequested InventoryAdjustment[]   @relation("InventoryAdjustmentRequester")
  inventoryAdjustmentsDecided   InventoryAdjustment[]   @relation("InventoryAdjustmentDecider")
  inventoryLedgerEntries        InventoryLedgerEntry[]

  @@map("users")
}

model Business {
  id              String         @id @default(uuid()) @db.Uuid
  name            String         @db.VarChar(160)
  slug            String         @unique @db.VarChar(100)
  status          BusinessStatus @default(PENDING)
  defaultCurrency String         @default("BDT") @map("default_currency") @db.Char(3)
  defaultTimezone String         @default("Asia/Dhaka") @map("default_timezone") @db.VarChar(64)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  version         BigInt         @default(1)

  memberships            TenantMembership[]
  branches               Branch[]
  roles                  Role[]
  auditEvents            AuditEvent[]
  categories             Category[]
  brands                 Brand[]
  suppliers              Supplier[]
  products               Product[]
  inventoryBalances      InventoryBalance[]
  inventoryOperations    InventoryOperation[]
  inventoryAdjustments   InventoryAdjustment[]
  inventoryLedgerEntries InventoryLedgerEntry[]
  inventorySerialUnits   InventorySerialUnit[]

  @@map("businesses")
}

model TenantMembership {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  status    String    @default("INVITED") @db.VarChar(32)
  joinedAt  DateTime? @map("joined_at") @db.Timestamptz(3)
  leftAt    DateTime? @map("left_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  version   BigInt    @default(1)

  business Business @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  roleAssignments MembershipRole[]
  branchScopes    MembershipBranchScope[]

  @@unique([tenantId, userId])
  @@unique([tenantId, id])
  @@index([userId, status])
  @@map("tenant_memberships")
}

model Branch {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  code      String   @db.VarChar(32)
  name      String   @db.VarChar(160)
  status    String   @default("ACTIVE") @db.VarChar(32)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  version   BigInt   @default(1)

  business Business @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  membershipScopes       MembershipBranchScope[]
  inventoryBalances      InventoryBalance[]
  inventoryAdjustments   InventoryAdjustment[]
  inventoryLedgerEntries InventoryLedgerEntry[]
  inventorySerialUnits   InventorySerialUnit[]

  @@unique([tenantId, code])
  @@unique([tenantId, id])
  @@map("branches")
}

model Role {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  name         String   @db.VarChar(100)
  isSystem     Boolean  @default(false) @map("is_system")
  status       String   @default("ACTIVE") @db.VarChar(32)
  templateCode String?  @map("template_code") @db.VarChar(64)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  version      BigInt   @default(1)

  business        Business         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  permissions     RolePermission[]
  membershipRoles MembershipRole[]

  @@unique([tenantId, name])
  @@unique([tenantId, id])
  @@map("roles")
}

model Permission {
  code        String @id @db.VarChar(100)
  description String @db.VarChar(255)
  riskClass   String @map("risk_class") @db.VarChar(32)

  roleAssignments RolePermission[]

  @@map("permissions")
}

model RolePermission {
  tenantId       String   @map("tenant_id") @db.Uuid
  roleId         String   @map("role_id") @db.Uuid
  permissionCode String   @map("permission_code") @db.VarChar(100)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  role Role @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Restrict)

  permission Permission @relation(fields: [permissionCode], references: [code], onDelete: Restrict)

  @@id([tenantId, roleId, permissionCode])
  @@index([permissionCode])
  @@map("role_permissions")
}

model MembershipRole {
  tenantId     String   @map("tenant_id") @db.Uuid
  membershipId String   @map("membership_id") @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  membership TenantMembership @relation(fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Restrict)
  role       Role             @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Restrict)

  @@id([tenantId, membershipId, roleId])
  @@index([tenantId, roleId])
  @@map("membership_roles")
}

model MembershipBranchScope {
  id           String          @id @default(uuid()) @db.Uuid
  tenantId     String          @map("tenant_id") @db.Uuid
  membershipId String          @map("membership_id") @db.Uuid
  scopeType    BranchScopeType @map("scope_type")
  branchId     String?         @map("branch_id") @db.Uuid
  canView      Boolean         @default(true) @map("can_view")
  canOperate   Boolean         @default(false) @map("can_operate")
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  membership TenantMembership @relation(fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Restrict)
  branch     Branch?          @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, membershipId])
  @@map("membership_branch_scopes")
}

model Category {
  id        String          @id @default(uuid()) @db.Uuid
  tenantId  String          @map("tenant_id") @db.Uuid
  parentId  String?         @map("parent_id") @db.Uuid
  name      String          @db.VarChar(120)
  slug      String          @db.VarChar(140)
  status    CatalogueStatus @default(ACTIVE)
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  business Business   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  parent   Category?  @relation("CategoryTree", fields: [tenantId, parentId], references: [tenantId, id], onDelete: Restrict)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@unique([tenantId, id])
  @@unique([tenantId, slug])
  @@index([tenantId, parentId, status])
  @@map("categories")
}

model Brand {
  id             String          @id @default(uuid()) @db.Uuid
  tenantId       String          @map("tenant_id") @db.Uuid
  name           String          @db.VarChar(120)
  nameNormalized String          @map("name_normalized") @db.VarChar(120)
  status         CatalogueStatus @default(ACTIVE)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  business Business  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  products Product[]

  @@unique([tenantId, id])
  @@unique([tenantId, nameNormalized])
  @@index([tenantId, status, name])
  @@map("brands")
}

model Supplier {
  id             String          @id @default(uuid()) @db.Uuid
  tenantId       String          @map("tenant_id") @db.Uuid
  name           String          @db.VarChar(160)
  nameNormalized String          @map("name_normalized") @db.VarChar(160)
  contactName    String?         @map("contact_name") @db.VarChar(160)
  email          String?         @db.VarChar(320)
  phone          String?         @db.VarChar(40)
  address        String?         @db.VarChar(500)
  notes          String?         @db.VarChar(2000)
  status         CatalogueStatus @default(ACTIVE)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  version        BigInt          @default(1)

  business Business @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, nameNormalized])
  @@index([tenantId, status, name])
  @@map("suppliers")
}

model Product {
  id           String          @id @default(uuid()) @db.Uuid
  tenantId     String          @map("tenant_id") @db.Uuid
  productCode  String          @map("product_code") @db.VarChar(64)
  name         String          @db.VarChar(180)
  description  String?         @db.VarChar(2000)
  productKind  ProductKind     @map("product_kind")
  categoryId   String?         @map("category_id") @db.Uuid
  brandId      String?         @map("brand_id") @db.Uuid
  trackSerials Boolean         @default(false) @map("track_serials")
  status       CatalogueStatus @default(ACTIVE)
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  version      BigInt          @default(1)

  business               Business               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  category               Category?              @relation(fields: [tenantId, categoryId], references: [tenantId, id], onDelete: Restrict)
  brand                  Brand?                 @relation(fields: [tenantId, brandId], references: [tenantId, id], onDelete: Restrict)
  variants               ProductVariant[]
  identifiers            ProductIdentifier[]
  prices                 ProductPrice[]
  inventoryBalances      InventoryBalance[]
  inventoryAdjustments   InventoryAdjustment[]
  inventoryLedgerEntries InventoryLedgerEntry[]
  inventorySerialUnits   InventorySerialUnit[]

  @@unique([tenantId, id])
  @@unique([tenantId, productCode])
  @@index([tenantId, status, name])
  @@index([tenantId, categoryId])
  @@index([tenantId, brandId])
  @@map("products")
}

model ProductVariant {
  id          String          @id @default(uuid()) @db.Uuid
  tenantId    String          @map("tenant_id") @db.Uuid
  productId   String          @map("product_id") @db.Uuid
  variantCode String          @map("variant_code") @db.VarChar(64)
  sku         String          @db.VarChar(100)
  name        String          @db.VarChar(180)
  attributes  Json            @default("{}") @db.JsonB
  isDefault   Boolean         @default(false) @map("is_default")
  status      CatalogueStatus @default(ACTIVE)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  version     BigInt          @default(1)

  product                Product                @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)
  identifiers            ProductIdentifier[]
  prices                 ProductPrice[]
  inventoryBalances      InventoryBalance[]
  inventoryAdjustments   InventoryAdjustment[]
  inventoryLedgerEntries InventoryLedgerEntry[]
  inventorySerialUnits   InventorySerialUnit[]

  @@unique([tenantId, productId, id])
  @@unique([tenantId, productId, variantCode])
  @@index([tenantId, productId, status])
  @@map("product_variants")
}

model ProductIdentifier {
  id              String                @id @default(uuid()) @db.Uuid
  tenantId        String                @map("tenant_id") @db.Uuid
  productId       String                @map("product_id") @db.Uuid
  variantId       String                @map("variant_id") @db.Uuid
  identifierType  ProductIdentifierType @map("identifier_type")
  valueNormalized String                @map("value_normalized") @db.VarChar(160)
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  product Product        @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)
  variant ProductVariant @relation(fields: [tenantId, productId, variantId], references: [tenantId, productId, id], onDelete: Restrict)

  @@unique([tenantId, identifierType, valueNormalized])
  @@unique([tenantId, id])
  @@index([tenantId, variantId])
  @@map("product_identifiers")
}

model ProductPrice {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  productId   String    @map("product_id") @db.Uuid
  variantId   String    @map("variant_id") @db.Uuid
  currency    String    @db.Char(3)
  amountMinor BigInt    @map("amount_minor")
  validFrom   DateTime  @default(now()) @map("valid_from") @db.Timestamptz(3)
  validTo     DateTime? @map("valid_to") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  product Product        @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)
  variant ProductVariant @relation(fields: [tenantId, productId, variantId], references: [tenantId, productId, id], onDelete: Restrict)

  @@index([tenantId, variantId, validFrom])
  @@map("product_prices")
}

model AuthSession {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  sessionHash   String    @unique @map("session_hash") @db.Char(64)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(3)
  lastSeenAt    DateTime? @map("last_seen_at") @db.Timestamptz(3)
  userAgent     String?   @map("user_agent") @db.VarChar(512)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  mfaVerifiedAt DateTime? @map("mfa_verified_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model EmailVerificationToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model RateLimitBucket {
  keyHash     String   @map("key_hash") @db.Char(64)
  windowStart DateTime @map("window_start") @db.Timestamptz(3)
  hitCount    Int      @default(1) @map("hit_count")
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(3)

  @@id([keyHash, windowStart])
  @@index([expiresAt])
  @@map("rate_limit_buckets")
}

model PlatformAdministrator {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  role            String    @db.VarChar(40)
  status          String    @default("ACTIVE") @db.VarChar(32)
  grantedByUserId String?   @map("granted_by_user_id") @db.Uuid
  grantedAt       DateTime  @default(now()) @map("granted_at") @db.Timestamptz(3)
  revokedByUserId String?   @map("revoked_by_user_id") @db.Uuid
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  version         BigInt    @default(1)

  user      User  @relation("PlatformAdminSubject", fields: [userId], references: [id], onDelete: Restrict)
  grantedBy User? @relation("PlatformAdminGrantor", fields: [grantedByUserId], references: [id], onDelete: Restrict)
  revokedBy User? @relation("PlatformAdminRevoker", fields: [revokedByUserId], references: [id], onDelete: Restrict)

  @@index([status, role])
  @@map("platform_administrators")
}

model UserMfa {
  id                   String    @id @default(uuid()) @db.Uuid
  userId               String    @unique @map("user_id") @db.Uuid
  encryptedSecret      Bytes     @map("encrypted_secret") @db.ByteA
  status               String    @default("PENDING") @db.VarChar(16)
  lastAcceptedTimeStep BigInt?   @map("last_accepted_time_step")
  enabledAt            DateTime? @map("enabled_at") @db.Timestamptz(3)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("user_mfa")
}

model MfaEnrollment {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @unique @map("user_id") @db.Uuid
  encryptedSecret Bytes    @map("encrypted_secret") @db.ByteA
  expiresAt       DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([expiresAt])
  @@map("mfa_enrollments")
}

model MfaRecoveryCode {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  codeHash   String    @unique @map("code_hash") @db.Char(64)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, consumedAt])
  @@map("mfa_recovery_codes")
}

model MfaChallenge {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, expiresAt])
  @@map("mfa_challenges")
}

model AuditEvent {
  id          String   @id @default(uuid()) @db.Uuid
  occurredAt  DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)
  actorType   String   @map("actor_type") @db.VarChar(16)
  actorUserId String?  @map("actor_user_id") @db.Uuid
  tenantId    String?  @map("tenant_id") @db.Uuid
  action      String   @db.VarChar(120)
  targetType  String   @map("target_type") @db.VarChar(80)
  targetId    String?  @map("target_id") @db.VarChar(160)
  outcome     String   @db.VarChar(16)
  requestId   String?  @map("request_id") @db.VarChar(128)
  ipAddress   String?  @map("ip_address") @db.VarChar(64)
  userAgent   String?  @map("user_agent") @db.VarChar(512)
  metadata    Json     @default("{}") @db.JsonB

  actor  User?     @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  tenant Business? @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([tenantId, occurredAt])
  @@index([targetType, targetId])
  @@map("audit_events")
}

// ============================================================
// M2 — Inventory foundation
// ============================================================

enum InventoryOperationType {
  ADJUSTMENT_SUBMIT
  ADJUSTMENT_APPROVE
  ADJUSTMENT_REJECT
}

enum InventoryAdjustmentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum InventorySerialUnitStatus {
  IN_STOCK
  REMOVED
}

model InventoryBalance {
  id                String         @id @default(uuid()) @db.Uuid
  tenantId          String         @map("tenant_id") @db.Uuid
  branchId          String         @map("branch_id") @db.Uuid
  productId         String         @map("product_id") @db.Uuid
  variantId         String         @map("variant_id") @db.Uuid
  physicalQuantity  Int            @default(0) @map("physical_quantity")
  reservedQuantity  Int            @default(0) @map("reserved_quantity")
  inTransitQuantity Int            @default(0) @map("in_transit_quantity")
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  version           BigInt         @default(1)
  business          Business       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch            Branch         @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  product           Product        @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)
  variant           ProductVariant @relation(fields: [tenantId, productId, variantId], references: [tenantId, productId, id], onDelete: Restrict)

  @@unique([tenantId, branchId, variantId])
  @@unique([tenantId, id])
  @@index([tenantId, productId, branchId])
  @@map("inventory_balances")
}

model InventoryOperation {
  id                   String                 @id @default(uuid()) @db.Uuid
  tenantId             String                 @map("tenant_id") @db.Uuid
  operationType        InventoryOperationType @map("operation_type")
  idempotencyKey       String                 @map("idempotency_key") @db.VarChar(160)
  requestHash          String                 @map("request_hash") @db.Char(64)
  actorUserId          String                 @map("actor_user_id") @db.Uuid
  targetId             String?                @map("target_id") @db.Uuid
  result               Json?
  completedAt          DateTime?              @map("completed_at") @db.Timestamptz(3)
  createdAt            DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  business             Business               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  actor                User                   @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  submittedAdjustments InventoryAdjustment[]  @relation("AdjustmentSubmissionOperation")
  decidedAdjustments   InventoryAdjustment[]  @relation("AdjustmentDecisionOperation")
  ledgerEntries        InventoryLedgerEntry[]

  @@unique([tenantId, idempotencyKey])
  @@unique([tenantId, id])
  @@index([tenantId, targetId, operationType])
  @@map("inventory_operations")
}

model InventoryAdjustment {
  id                    String                    @id @default(uuid()) @db.Uuid
  tenantId              String                    @map("tenant_id") @db.Uuid
  branchId              String                    @map("branch_id") @db.Uuid
  productId             String                    @map("product_id") @db.Uuid
  variantId             String                    @map("variant_id") @db.Uuid
  requestedBy           String                    @map("requested_by") @db.Uuid
  submissionOperationId String                    @unique @map("submission_operation_id") @db.Uuid
  quantityDelta         Int                       @map("quantity_delta")
  reason                String                    @db.VarChar(500)
  serialChanges         Json                      @default("[]") @map("serial_changes") @db.JsonB
  status                InventoryAdjustmentStatus @default(PENDING)
  decidedBy             String?                   @map("decided_by") @db.Uuid
  decisionReason        String?                   @map("decision_reason") @db.VarChar(500)
  decidedAt             DateTime?                 @map("decided_at") @db.Timestamptz(3)
  createdAt             DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)
  decisionOperationId   String?                   @unique @map("decision_operation_id") @db.Uuid
  business              Business                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch                Branch                    @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  product               Product                   @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)
  variant               ProductVariant            @relation(fields: [tenantId, productId, variantId], references: [tenantId, productId, id], onDelete: Restrict)
  requester             User                      @relation("InventoryAdjustmentRequester", fields: [requestedBy], references: [id], onDelete: Restrict)
  decider               User?                     @relation("InventoryAdjustmentDecider", fields: [decidedBy], references: [id], onDelete: Restrict)
  submissionOperation   InventoryOperation        @relation("AdjustmentSubmissionOperation", fields: [tenantId, submissionOperationId], references: [tenantId, id], onDelete: Restrict)
  decisionOperation     InventoryOperation?       @relation("AdjustmentDecisionOperation", fields: [tenantId, decisionOperationId], references: [tenantId, id], onDelete: Restrict)
  ledgerEntry           InventoryLedgerEntry?
  serialUnitsAdded      InventorySerialUnit[]     @relation("SerialAddedByAdjustment")
  serialUnitsRemoved    InventorySerialUnit[]     @relation("SerialRemovedByAdjustment")

  @@unique([tenantId, id])
  @@index([tenantId, branchId, status, createdAt])
  @@index([tenantId, variantId, createdAt])
  @@map("inventory_adjustments")
}

model InventoryLedgerEntry {
  id            String              @id @default(uuid()) @db.Uuid
  tenantId      String              @map("tenant_id") @db.Uuid
  branchId      String              @map("branch_id") @db.Uuid
  productId     String              @map("product_id") @db.Uuid
  variantId     String              @map("variant_id") @db.Uuid
  adjustmentId  String              @unique @map("adjustment_id") @db.Uuid
  operationId   String              @unique @map("operation_id") @db.Uuid
  quantityDelta Int                 @map("quantity_delta")
  balanceAfter  Int                 @map("balance_after")
  actorUserId   String              @map("actor_user_id") @db.Uuid
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  business      Business            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch        Branch              @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  product       Product             @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)
  variant       ProductVariant      @relation(fields: [tenantId, productId, variantId], references: [tenantId, productId, id], onDelete: Restrict)
  adjustment    InventoryAdjustment @relation(fields: [tenantId, adjustmentId], references: [tenantId, id], onDelete: Restrict)
  operation     InventoryOperation  @relation(fields: [tenantId, operationId], references: [tenantId, id], onDelete: Restrict)
  actor         User                @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, adjustmentId])
  @@unique([tenantId, operationId])
  @@index([tenantId, variantId, branchId, createdAt])
  @@index([tenantId, adjustmentId])
  @@map("inventory_ledger_entries")
}

model InventorySerialUnit {
  id                    String                    @id @default(uuid()) @db.Uuid
  tenantId              String                    @map("tenant_id") @db.Uuid
  branchId              String                    @map("branch_id") @db.Uuid
  productId             String                    @map("product_id") @db.Uuid
  variantId             String                    @map("variant_id") @db.Uuid
  serialNormalized      String                    @map("serial_normalized") @db.VarChar(160)
  status                InventorySerialUnitStatus @default(IN_STOCK)
  addedByAdjustmentId   String                    @map("added_by_adjustment_id") @db.Uuid
  removedByAdjustmentId String?                   @map("removed_by_adjustment_id") @db.Uuid
  createdAt             DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)
  business              Business                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch                Branch                    @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  product               Product                   @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)
  variant               ProductVariant            @relation(fields: [tenantId, productId, variantId], references: [tenantId, productId, id], onDelete: Restrict)
  addedByAdjustment     InventoryAdjustment       @relation("SerialAddedByAdjustment", fields: [tenantId, addedByAdjustmentId], references: [tenantId, id], onDelete: Restrict)
  removedByAdjustment   InventoryAdjustment?      @relation("SerialRemovedByAdjustment", fields: [tenantId, removedByAdjustmentId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, variantId, serialNormalized])
  @@unique([tenantId, id])
  @@index([tenantId, branchId, variantId, status])
  @@index([tenantId, addedByAdjustmentId])
  @@map("inventory_serial_units")
}
