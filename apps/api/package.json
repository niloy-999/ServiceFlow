{
  "name": "@serviceflow/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "prisma generate && tsc --noEmit -p tsconfig.json",
    "db:generate": "prisma generate",
    "test:tenant-isolation": "node --test test/tenant-isolation.integration.mjs",
    "test:password": "node --test test/password.service.test.mjs",
    "test:auth-session": "node --test test/auth-session.integration.mjs"
  },
  "dependencies": {
    "@nestjs/common": "12.5.1",
    "@nestjs/core": "12.5.1",
    "@nestjs/platform-express": "12.5.1",
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "18.0.10",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@serviceflow/config": "workspace:*",
    "@types/node": "24.10.0",
    "prisma": "7.10.1"
  }
}
